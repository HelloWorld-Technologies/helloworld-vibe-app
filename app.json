{
  "expo": {
    "name": "HelloWorld",
    "slug": "helloworld",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thehelloworld",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "dayal-thehelloworld",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "org.HelloWorldTechnologiesIndiaPvtLtd.react.native.HelloWorld",
      "buildNumber": "151",
      "googleServicesFile": "./GoogleService-Info.plist",
      "appleTeamId": "FY57RG66TM",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow HelloWorld to access your photos so you can attach images to support tickets.",
        "NSPhotoLibraryAddUsageDescription": "Allow HelloWorld to save images related to your support tickets."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0BA5EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.thehelloworld",
      "versionCode": 275,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#0BA5EC",
      "iosDisplayInForeground": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0BA5EC",
          "image": "./assets/images/splash-gradient.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "backgroundColor": "#0BA5EC",
            "image": "./assets/images/splash-gradient.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "backgroundColor": "#0BA5EC",
            "image": "./assets/images/splash-transparent.png",
            "imageWidth": 1,
            "resizeMode": "native"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Satoshi-Variable.ttf",
            "./assets/fonts/Satoshi-Light.ttf",
            "./assets/fonts/Satoshi-Regular.ttf",
            "./assets/fonts/Satoshi-Medium.ttf",
            "./assets/fonts/Satoshi-Bold.ttf",
            "./assets/fonts/Satoshi-Black.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HelloWorld to access your photos so you can attach images to support tickets.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-sharing",
      "./plugins/with-android-release-signing.js",
      "./plugins/with-android-splash-gradient.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cb885a4e-f18b-4d7e-8a45-2cd1fe69a26c"
      }
    }
  }
}
