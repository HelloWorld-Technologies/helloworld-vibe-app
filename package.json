{
  "name": "helloworld-vibe-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~56.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "^25.0.0",
    "@react-native-firebase/app": "^25.0.0",
    "@react-native-firebase/crashlytics": "^25.0.0",
    "@react-native-firebase/messaging": "^25.0.0",
    "@tanstack/react-query": "^5.101.1",
    "axios": "^1.18.1",
    "cashfree-pg-api-contract": "^2.1.1",
    "expo": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.22",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.5",
    "lottie-react-native": "~7.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-cashfree-pg-sdk": "^2.4.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "4.5.0",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/link-hw-assets.js && node ./scripts/sync-hw-assets.js && node ./scripts/compress-assets.js",
    "link:assets": "node ./scripts/link-hw-assets.js",
    "sync:assets": "node ./scripts/sync-hw-assets.js && node ./scripts/compress-assets.js",
    "compress:assets": "node ./scripts/compress-assets.js --include-images",
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "android:prebuild": "expo prebuild --platform android",
    "android:assemble:debug": "cd android && ./gradlew assembleDebug",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:assemble": "npm run android:assemble:release",
    "android:apk": "npm run android:assemble:release",
    "android:install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:install:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install": "npm run android:install:release",
    "android:apk:install": "npm run android:apk && npm run android:install:release",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "android:bundle": "npm run android:bundle:release",
    "android:build:debug": "npm run android:prebuild && npm run android:assemble:debug",
    "android:build:release": "npm run android:prebuild && npm run android:assemble:release",
    "android:build:apk": "npm run android:prebuild && npm run android:apk",
    "android:build:bundle": "npm run android:prebuild && npm run android:bundle:release",
    "android:build": "npm run android:build:release",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:simulator": "eas build --profile development-simulator --platform ios",
    "build:dev:local:android": "eas build --profile development --platform android --local",
    "build:dev:local:ios": "eas build --profile development --platform ios --local",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "screenshots:android": "adb exec-out screencap -p > ~/Desktop/screenshot.png"
  },
  "private": true
}
